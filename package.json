{
  "name": "automated-climate-action-maker",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated Climate Action Maker Chrome Extension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "launch": "node scripts/launch.mjs",
    "test": "npm run check:guardrails",
    "test:stream": "npm run build && node tests/test-history-stream.mjs",
    "test:migration": "npm run build && node tests/test-storage-migration.mjs",
    "test:e2e": "npm run build && node tests/test-e2e-all.mjs",
    "pack:store": "node scripts/pack-store.mjs",
    "build:privacy": "node scripts/build-privacy-page.mjs",
    "publish:cws": "node scripts/publish-cws.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:store-assets": "node scripts/generate-store-assets.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:runtime": "npm run build && node tests/test-runtime-guardrails.mjs",
    "check:guardrails": "npm run typecheck && npm run check:static && npm run test:migration && npm run check:runtime",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.12.0",
    "typescript": "^5.8.0"
  }
}
