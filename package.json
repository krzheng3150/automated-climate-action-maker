{
  "name": "automated-climate-action-maker",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated Climate Action Maker Chrome Extension",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "launch": "node launch.mjs",
    "test": "npm run check:guardrails",
    "test:stream": "npm run build && node test-history-stream.mjs",
    "check:static": "node check-static.mjs",
    "check:runtime": "npm run build && node test-runtime-guardrails.mjs",
    "check:guardrails": "npm run typecheck && npm run check:static && npm run check:runtime",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.12.0",
    "typescript": "^5.8.0"
  }
}
