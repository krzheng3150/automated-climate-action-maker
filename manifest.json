{
  "manifest_version": 3,
  "name": "Automated Climate Action Maker",
  "version": "0.1.0",
  "description": "Scans web pages to suggest and automate climate-friendly alternatives and actions.",
  "permissions": [
    "storage",
    "activeTab",
    "history"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Automated Climate Action Maker"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}